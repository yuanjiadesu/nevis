# Docker Compose pins the application and search values in this first block. They document
# intended container values; changing them here does not change containers. Compose-supported
# ports and optional summary settings are labelled below.
NEVIS_ENVIRONMENT=local
NEVIS_IDENTITY_PROVIDER=local-header
NEVIS_DATABASE_URL=postgresql+asyncpg://nevis:nevis@postgres:5432/nevis
NEVIS_EMBEDDING_PROVIDER=tei
NEVIS_TEI_BASE_URL=http://tei:80
NEVIS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NEVIS_EMBEDDING_MODEL_REVISION=5c38ec7
NEVIS_EMBEDDING_DIMENSIONS=384
NEVIS_EMBEDDING_NORMALIZATION=l2
NEVIS_EMBEDDING_CHUNKING_VERSION=1
NEVIS_EMBEDDING_PIPELINE_VERSION=1
NEVIS_RERANKER_PROVIDER=tei
NEVIS_RERANKER_BASE_URL=http://reranker:80
NEVIS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
NEVIS_RERANKER_MODEL_REVISION=c5ee24c
NEVIS_RERANKER_TIMEOUT_SECONDS=1.0
NEVIS_LOG_LEVEL=INFO

# Docker Compose host ports:
NEVIS_API_PORT=8001
NEVIS_DATABASE_PORT=5432

# Host-run search defaults. Current Docker Compose services do not receive these values:
NEVIS_SEARCH_QUERY_MAX_LENGTH=500
NEVIS_SEARCH_DEFAULT_LIMIT=20
NEVIS_SEARCH_MAX_LIMIT=50
NEVIS_SEARCH_LEXICAL_CANDIDATES=100
NEVIS_SEARCH_SEMANTIC_CANDIDATES=100
NEVIS_SEARCH_CLIENT_CANDIDATES=100
NEVIS_SEARCH_CLIENT_DESCRIPTION_EXCERPT_LENGTH=180
NEVIS_SEARCH_CLIENT_WEIGHT=1.0
NEVIS_SEARCH_DOCUMENT_LEXICAL_WEIGHT=1.0
NEVIS_SEARCH_DOCUMENT_SEMANTIC_WEIGHT=1.0
NEVIS_SEARCH_RANKING_VERSION=mixed-rrf-v5
NEVIS_SEARCH_SEMANTIC_CANDIDATE_THRESHOLD=0.60
NEVIS_SEARCH_RERANKER_CANDIDATES=10
NEVIS_SEARCH_RERANKER_THRESHOLD=0.005
NEVIS_SEARCH_DOCUMENT_RERANKER_WEIGHT=1.0
NEVIS_SEARCH_RRF_VERSION=1
NEVIS_SEARCH_RRF_CONSTANT=60
NEVIS_SEARCH_SNIPPET_LENGTH=280
NEVIS_SEARCH_CURSOR_TTL_SECONDS=900
# Required outside local/test; use a secret manager in deployed environments.
NEVIS_SEARCH_CURSOR_SIGNING_KEY=nevis-local-cursor-signing-key-change-me

# Docker Compose supports this complete optional-summary block. Summaries send fictional
# document text to an LLM. See docs/model-providers.md.
NEVIS_DOCUMENT_SUMMARIES_ENABLED=false
NEVIS_FICTIONAL_TEST_DATA=false
NEVIS_LLM_PROVIDER=opencode-go
NEVIS_LLM_MODEL=mimo-v2.5
NEVIS_LLM_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
NEVIS_DOCUMENT_SUMMARY_PROVIDER_MAX_TOKENS=500
NEVIS_SUMMARY_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
NEVIS_SUMMARY_WORKER_HEARTBEAT_FRESHNESS_SECONDS=20
NEVIS_LLM_API_KEY=

# Host-run production OIDC example. Current Compose is local/fictional UAT and ignores it:
# NEVIS_ENVIRONMENT=production
# NEVIS_IDENTITY_PROVIDER=oidc
# NEVIS_OIDC_ISSUER=https://identity.example.com/
# NEVIS_OIDC_AUDIENCE=nevis-search
# NEVIS_OIDC_ALGORITHMS=RS256
# NEVIS_OIDC_TOKEN_MAX_LENGTH=16384
# NEVIS_OIDC_SUBJECT_MAX_LENGTH=200
# NEVIS_OIDC_CLOCK_SKEW_SECONDS=30
# NEVIS_OIDC_JWKS_FRESH_TTL_SECONDS=900
# NEVIS_OIDC_JWKS_MAX_STALE_SECONDS=86400
# NEVIS_OIDC_JWKS_REFRESH_MIN_INTERVAL_SECONDS=30
# NEVIS_OIDC_HTTP_TIMEOUT_SECONDS=5
# NEVIS_OIDC_RESPONSE_MAX_BYTES=1048576
